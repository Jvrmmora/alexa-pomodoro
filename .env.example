# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/
MONGODB_DB=pomodoro
# userId de Alexa del dueño (se descubre en los logs en la primera prueba)
ALEXA_OWNER_ID=
# Panel web: contraseña de acceso y secreto para firmar la cookie de sesión
PANEL_PASSWORD=
PANEL_SECRET=
# Opcional: sincronizar cada foco terminado con una base de Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=
